{
  "name": "agrichain-backend",
  "version": "1.0.0",
  "description": "AgriChain Backend API with Express, Mongoose, MongoDB, JWT, and Web3 integration",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node -e \"console.log('Build completed')\"",
    "seed": "node scripts/seed-mongodb.js",
    "db:verify": "node scripts/verify-mongodb-system.js",
