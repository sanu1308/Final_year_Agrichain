    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.0",
    "qrcode": "^1.5.3",
    "zod": "^3.23.8"
