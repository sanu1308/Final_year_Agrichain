# ==============================================================================
# AgriChain Backend Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Local MongoDB:
MONGODB_URI="mongodb://127.0.0.1:27017/agrichain"
# Production Cloud MongoDB (Atlas):
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrichain?retryWrites=true&w=majority"

# Authentication Security
JWT_SECRET="replace_with_a_secure_random_64_char_string_for_production"
JWT_EXPIRES_IN="7d"

# Blockchain Web3 Settings
# Local Hardhat Node:
RPC_URL="http://127.0.0.1:8545"
# Production Ethereum / Polygon RPC (Alchemy or Infura):
# RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"
# CONTRACT_ADDRESS="0xYourDeployedSmartContractAddress"

# Frontend & QR URLs
# In local development:
CLIENT_URL="http://localhost:5173"
PUBLIC_CLIENT_URL="http://localhost:5173"

# Optional: Override automatic LAN detection for QR code generation in local development.
# By default when NODE_ENV=development, the backend automatically detects the active
# host LAN IPv4 address (e.g. http://192.168.1.50:5173 or http://10.x.x.x:5173) so mobile
# phones on the same Wi-Fi can scan the QR code to reach the verification page.
# If automatic detection picks the wrong adapter, you can explicitly set LOCAL_CLIENT_URL:
# LOCAL_CLIENT_URL="http://<YOUR_LAN_IP>:5173"

# In production (used for QR code generation and CORS):
# CLIENT_URL="https://agrichain.vercel.app"
# PUBLIC_CLIENT_URL="https://agrichain.vercel.app"
# ALLOWED_ORIGINS="https://agrichain.vercel.app,https://agrichain.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:5173"
