# Sepolia RPC URL (Infura, Alchemy, or public Sepolia RPC)
# Examples:
# SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"
# SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"
# Public fallback: https://rpc.sepolia.org
SEPOLIA_RPC_URL="https://rpc.sepolia.org"

# Deployer Private Key for Sepolia (Testnet wallet with Sepolia ETH)
# DO NOT COMMIT YOUR REAL PRIVATE KEY!
# Enter a testnet wallet private key (64 hex characters, without or with 0x)
SEPOLIA_PRIVATE_KEY=""
