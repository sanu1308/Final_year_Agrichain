# ==============================================================================
# AgriChain Frontend Environment Configuration (Vite)
# ==============================================================================

# Backend API Endpoint
# In local development (defaults automatically to the current host/localhost:5000):
# VITE_API_URL="http://localhost:5000/api/v1"
# In production (e.g. deployed on Vercel connecting to cloud backend):
# VITE_API_URL="https://api.agrichain.yourdomain.com/api/v1"

# Web3 Smart Contract (Optional overrides - defaults to local contractData.json)
# VITE_CONTRACT_ADDRESS="0xYourDeployedContractAddress"
# VITE_CHAIN_ID="31337"
# VITE_RPC_URL="http://127.0.0.1:8545"

# For Sepolia Testnet deployment:
# VITE_CHAIN_ID="11155111"
# VITE_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"
